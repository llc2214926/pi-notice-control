{
  "enabled": true,
  "toolDisplay": {
    "enabled": true,
    "maxLines": 0,
    "collapseCommandErrors": true,
    "errorMaxLines": 5
  },
  "rules": [
    {
      "id": "sandbox-all-domains",
      "enabled": true,
      "match": {
        "type": "warning",
        "contains": "Network sandbox allows all domains because network.allowedDomains contains \"*\""
      },
      "action": "hide"
    }
  ]
}
